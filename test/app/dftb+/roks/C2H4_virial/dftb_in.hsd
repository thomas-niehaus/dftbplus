Geometry = GenFormat {
    <<< geo.gen
}

Hamiltonian = DFTB {
    SCC = Yes
    SCCTolerance = 1.0E-8  # Extremely small
    MaxAngularMomentum = {
        H = "s"
        C = "p"
    }
    
    Roks = Yes
    RoksMaxIterations = 50
    RoksTolerance = 1.0e-8
    RoksVirial = {
        HHubbard = {
            H = 0.68353
            C = 0.49748
        }
    }
    
    SlaterKosterFiles = Type2FileNames {
    	Prefix = "slakos/origin/mio-1-1/"
    	Separator = "-"
    	Suffix = ".skf"
    	LowerCaseTypeName = No
    }
    SpinPolarisation = Colinear {
        UnpairedElectrons = 2
    }
    SpinConstants = { 
        C = {
	    -0.04559 -0.02930
            -0.02930 -0.02755
        }
        H = {-0.07925}
        ShellResolvedSpin = Yes
    }
}

Options = {
    WriteAutotestTag = Yes
    WriteRoksDiagnostics = No
}

ParserOptions = {
    ParserVersion = 14
}